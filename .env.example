# Copy this file to server/.env and fill in your values.
# The app has two AI modes: "Premium" (Claude) and "Local" (Ollama).

# Premium mode — Anthropic Claude. Leave blank to use Local mode instead.
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Local mode — a local OpenAI-compatible model server (e.g. Ollama).
# Install Ollama, run `ollama pull qwen2.5:7b`, then set the base URL below.
# Leave LOCAL_AI_BASE_URL blank to keep the mode disabled.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=qwen2.5:7b

PORT=3001
NODE_ENV=development

# Neural TTS (natural Indian English interviewer voice) via Azure Speech.
# Create a free "Speech" resource in the Azure portal, then paste its key + region.
# Leave AZURE_SPEECH_KEY blank to fall back to the browser's built-in voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-IN-PrabhatNeural
